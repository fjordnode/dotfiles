#!/usr/bin/env zsh
# Interactive rm wrapper. Exact force flags bypass the prompt, matching rm.

rm() {
  local -a args=("$@") targets=()
  local arg options_done=0 force=0

  for arg in "${args[@]}"; do
    if (( options_done )); then
      targets+=("$arg")
      continue
    fi
    case "$arg" in
      --) options_done=1 ;;
      --force) force=1 ;;
      --*) ;;
      -*) [[ ${arg#-} == *f* ]] && force=1 ;;
      *) targets+=("$arg") ;;
    esac
  done

  (( force )) && { command rm "${args[@]}"; return $?; }

  local -a existing=()
  for arg in "${targets[@]}"; do
    [[ -e $arg || -L $arg ]] && existing+=("$arg")
  done
  (( ${#existing[@]} )) || { command rm "${args[@]}"; return $?; }

  local size
  size=$(du -ch -- "${existing[@]}" 2>/dev/null | awk 'END {print $1}')
  if (( ${#existing[@]} == 1 )); then
    printf 'Delete %q%s? [y/N] ' "${existing[1]}" "${size:+ ($size)}"
  else
    printf 'Delete %d items%s? [y/N] ' "${#existing[@]}" "${size:+ ($size)}"
  fi

  local answer
  IFS= read -r answer
  [[ $answer == y || $answer == Y ]] || { print 'Cancelled'; return 1; }
  command rm "${args[@]}"
}

alias rmsafe='rm'
alias rmreal='command rm'

rm-help() {
  print 'rm prompts once for existing targets unless -f/--force is supplied.'
  print 'Use rmreal to invoke the original command explicitly.'
}
