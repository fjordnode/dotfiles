#!/usr/bin/env bash
# npm wrapper for Pi's package manager (settings.json "npmCommand": ["pi-npm"]).
#
# Runs the real npm with the given argv, then re-applies the local package
# patches from ~/.pi/agent/patches after any install/update so they survive
# `pi install` and `pi update`. Output of non-install commands is untouched
# because Pi parses it (npm root -g, npm view, ...).
set -u

real_npm=""
while IFS= read -r candidate; do
  if [[ -x $candidate && $(readlink -f "$candidate") != $(readlink -f "$0") ]]; then
    real_npm=$candidate
    break
  fi
done < <(type -aP npm 2>/dev/null)
if [[ -z $real_npm ]]; then
  echo "pi-npm: npm not found on PATH" >&2
  exit 127
fi

"$real_npm" "$@"
status=$?

case "${1:-}" in
  install|i|add|update|up|upgrade|ci)
    apply="$HOME/.pi/agent/patches/apply.mjs"
    if [[ -f $apply ]]; then
      node "$apply" >&2 || true
    fi
    ;;
esac

exit $status
