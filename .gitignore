# local junk
.zsh_history
.zcompdump*
.cache/
*.swp
*.swo
*.bak
*.backup
*.backup.*
*.orig
*.tmp

# host-specific overrides
.zshrc.local
.gitconfig-work
oh-my-zsh/.oh-my-zsh/*
!oh-my-zsh/.oh-my-zsh/custom/
!oh-my-zsh/.oh-my-zsh/custom/**
oh-my-zsh/.oh-my-zsh/custom/plugins/
oh-my-zsh/.oh-my-zsh/custom/cache/
# noctalia: plugin source (reinstallable) + scratch colorschemes + runtime state
noctalia/.config/noctalia/plugins/
noctalia/.config/noctalia/colorschemes/Test/
noctalia/.config/noctalia/colorschemes/Test2/
# niri: editor backups + stale/unincluded fragments
niri/.config/niri/*.bak
niri/.config/niri/*.backup.*
