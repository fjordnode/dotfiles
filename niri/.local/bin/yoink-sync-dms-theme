#!/bin/bash
set -euo pipefail

# Converts the active Kitty theme to yoink's theme.toml format.
# The script name is kept for existing autostart configs.
DEST="$HOME/.config/yoink/theme.toml"
SRC=""

for candidate in \
    "$HOME/.config/kitty/current-theme.conf" \
    "$HOME/.config/kitty/themes/noctalia.conf" \
    "$HOME/.config/kitty/dank-theme.conf"
do
    if [ -f "$candidate" ]; then
        SRC="$candidate"
        break
    fi
done

[ -n "$SRC" ] || { echo "No Kitty theme found"; exit 1; }
mkdir -p "$(dirname "$DEST")"

{
    accent=$(awk '$1 == "active_border_color" { print $2; found=1; exit } $1 == "color4" { color4=$2 } END { if (!found && color4) print color4 }' "$SRC")
    [ -n "$accent" ] || accent="#7aa2f7"
    printf 'accent = "%s"\n' "$accent"

    while read -r key val _; do
        [ -n "${key:-}" ] || continue
        [[ "$key" == \#* ]] && continue
        case "$key" in
            cursor|foreground|background|selection_foreground|selection_background|color[0-9]|color1[0-5])
                printf '%s = "%s"\n' "$key" "$val"
                ;;
        esac
    done < "$SRC"
} > "$DEST"
