// Noctalia keybinding overrides.
// These replace universal fallbacks with Noctalia IPC equivalents.
binds {
    Mod+Space hotkey-overlay-title="Application Launcher" {
        spawn-sh "if pgrep -x noctalia >/dev/null; then \"$HOME/.local/noctalia-v5/bin/noctalia\" msg panel-toggle launcher; else qs ipc -c noctalia-shell call launcher toggle; fi";
    }
    Mod+M hotkey-overlay-title="Task Manager" {
        spawn-sh "if pgrep -x noctalia >/dev/null; then \"$HOME/.local/noctalia-v5/bin/noctalia\" msg panel-toggle control-center system; else qs ipc -c noctalia-shell call systemMonitor toggle; fi";
    }
    Mod+N hotkey-overlay-title="Notification Center" {
        spawn-sh "if pgrep -x noctalia >/dev/null; then \"$HOME/.local/noctalia-v5/bin/noctalia\" msg panel-toggle control-center notifications; else qs ipc -c noctalia-shell call notifications toggleHistory; fi";
    }
    Mod+Y hotkey-overlay-title="Browse Wallpapers" {
        spawn-sh "if pgrep -x noctalia >/dev/null; then \"$HOME/.local/noctalia-v5/bin/noctalia\" msg panel-toggle wallpaper; else qs ipc -c noctalia-shell call wallpaper toggle; fi";
    }
    Mod+Shift+W hotkey-overlay-title="Window Rule Editor" {
        spawn "niri-window-rule-editor";
    }
    Super+X hotkey-overlay-title="Power Menu" {
        spawn-sh "if pgrep -x noctalia >/dev/null; then \"$HOME/.local/noctalia-v5/bin/noctalia\" msg panel-toggle session; else qs ipc -c noctalia-shell call sessionMenu toggle; fi";
    }
    Ctrl+Alt+Delete hotkey-overlay-title="Task Manager" {
        spawn-sh "if pgrep -x noctalia >/dev/null; then \"$HOME/.local/noctalia-v5/bin/noctalia\" msg panel-toggle control-center system; else qs ipc -c noctalia-shell call systemMonitor toggle; fi";
    }

    Mod+Alt+L hotkey-overlay-title="Lock Screen" {
        spawn-sh "if pgrep -x noctalia >/dev/null; then \"$HOME/.local/noctalia-v5/bin/noctalia\" msg screen-lock; else qs ipc -c noctalia-shell call lockScreen lock; fi";
    }

    XF86AudioRaiseVolume allow-when-locked=true {
        spawn-sh "if pgrep -x noctalia >/dev/null; then \"$HOME/.local/noctalia-v5/bin/noctalia\" msg volume-up; else qs ipc -c noctalia-shell call volume increase; fi";
    }
    XF86AudioLowerVolume allow-when-locked=true {
        spawn-sh "if pgrep -x noctalia >/dev/null; then \"$HOME/.local/noctalia-v5/bin/noctalia\" msg volume-down; else qs ipc -c noctalia-shell call volume decrease; fi";
    }
    XF86AudioMute allow-when-locked=true {
        spawn-sh "if pgrep -x noctalia >/dev/null; then \"$HOME/.local/noctalia-v5/bin/noctalia\" msg volume-mute; else qs ipc -c noctalia-shell call volume muteOutput; fi";
    }
    XF86AudioMicMute allow-when-locked=true {
        spawn-sh "if pgrep -x noctalia >/dev/null; then \"$HOME/.local/noctalia-v5/bin/noctalia\" msg mic-mute; else qs ipc -c noctalia-shell call volume muteInput; fi";
    }
    XF86AudioPlay allow-when-locked=true {
        spawn-sh "if pgrep -x noctalia >/dev/null; then \"$HOME/.local/noctalia-v5/bin/noctalia\" msg media toggle; else qs ipc -c noctalia-shell call media playPause; fi";
    }
    XF86AudioPause allow-when-locked=true {
        spawn-sh "if pgrep -x noctalia >/dev/null; then \"$HOME/.local/noctalia-v5/bin/noctalia\" msg media toggle; else qs ipc -c noctalia-shell call media playPause; fi";
    }
    XF86AudioPrev allow-when-locked=true {
        spawn-sh "if pgrep -x noctalia >/dev/null; then \"$HOME/.local/noctalia-v5/bin/noctalia\" msg media previous; else qs ipc -c noctalia-shell call media previous; fi";
    }
    XF86AudioNext allow-when-locked=true {
        spawn-sh "if pgrep -x noctalia >/dev/null; then \"$HOME/.local/noctalia-v5/bin/noctalia\" msg media next; else qs ipc -c noctalia-shell call media next; fi";
    }

    XF86MonBrightnessUp allow-when-locked=true {
        spawn "brightnessctl" "--quiet" "set" "+5%";
    }
    XF86MonBrightnessDown allow-when-locked=true {
        spawn "brightnessctl" "--quiet" "set" "5%-";
    }
    Mod+XF86MonBrightnessUp allow-when-locked=true {
        spawn "brightnessctl" "--quiet" "--device" "kbd_backlight" "set" "+10%";
    }
    Mod+XF86MonBrightnessDown allow-when-locked=true {
        spawn "brightnessctl" "--quiet" "--device" "kbd_backlight" "set" "10%-";
    }
}
