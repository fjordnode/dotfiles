# local junk
.zsh_history
.zcompdump*
.cache/
*.swp
*.swo
*.bak
*.backup
*.backup.*
*.orig
*.tmp

# Pi credentials and runtime state must never be versioned
pi/**/node_modules/
pi/**/auth.json*
pi/**/pi-accounts.json*
pi/**/.env
pi/**/.env.*
pi/**/sessions/
pi/**/__pycache__/

# Pi generated state and private memory (not portable configuration)
pi/.pi/web-search-cache/
pi/.pi/agent/npm/
pi/.pi/agent/git/
pi/.pi/agent/sessions/
pi/.pi/agent/state/
pi/.pi/agent/artifacts/
pi/.pi/agent/missions/
pi/.pi/agent/pi-hermes-memory/
pi/.pi/agent/projects-memory/
pi/.pi/agent/session-finder/
pi/.pi/agent/memory.md
pi/.pi/agent/models-store.json
pi/.pi/agent/trust.json
pi/.pi/agent/provider-failover-state.json
pi/.pi/agent/run-history.jsonl
pi/.pi/agent/usage*.json
pi/.pi/agent/*.log
pi/.pi/agent/*.sqlite*

# host-specific overrides
.zshrc.local
.gitconfig-work
oh-my-zsh/.oh-my-zsh/*
!oh-my-zsh/.oh-my-zsh/custom/
!oh-my-zsh/.oh-my-zsh/custom/**
oh-my-zsh/.oh-my-zsh/custom/plugins/
oh-my-zsh/.oh-my-zsh/custom/cache/
# noctalia: plugin source (reinstallable) + scratch colorschemes + runtime state
noctalia/.config/noctalia/plugins/
noctalia/.config/noctalia/colorschemes/Test/
noctalia/.config/noctalia/colorschemes/Test2/
# niri: editor backups + stale/unincluded fragments
niri/.config/niri/*.bak
niri/.config/niri/*.backup.*
